# Datenbank (docker compose up -d db)
DATABASE_URL=postgres://opengeo:opengeo@localhost:5433/opengeo
# Auth (better-auth) – beliebige lange Zufallszeichenkette
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
# Engines
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 1 = alle Engines durch den kostenlosen Mock-Adapter ersetzen (Tests)
OPENGEO_MOCK_ENGINES=0
# Kostenschutz beim Hosting: Obergrenze für das Monatsbudget eines Workspaces in USD (Standard 200)
OPENGEO_MAX_BUDGET_USD=200
# Selbstregistrierung erlauben (Standard true; "false" sperrt /signup und die Registrierungs-API)
OPENGEO_ALLOW_SIGNUP=true
