# OpenGEO configuration. Copy to .env and fill in.
# The same file is used for local development (pnpm dev / pnpm worker) and by `docker compose up -d`.
# Never commit .env.

# --- Database -------------------------------------------------------------------------------
# Development: Postgres from `pnpm db:up` (docker-compose.dev.yml, port 5433).
# Docker self-hosting ignores this and connects to the bundled `db` service using POSTGRES_PASSWORD.
DATABASE_URL=postgres://opengeo:opengeo@localhost:5433/opengeo
# Docker self-hosting only (required there): password of the bundled Postgres.
# Use URL-safe characters without `$`, e.g. `openssl rand -hex 24`. Changing it later does not change an existing database.
POSTGRES_PASSWORD=

# --- Auth (better-auth) ---------------------------------------------------------------------
# Required: long random string, e.g. `openssl rand -hex 32` (avoid `$` – Compose treats it as a variable). Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Base URL users open in the browser (with https:// behind a reverse proxy, e.g. https://geo.example.com).
BETTER_AUTH_URL=http://localhost:3010
# Allow self-signup (default true). "false" disables /signup and the sign-up API – create your accounts first.
OPENGEO_ALLOW_SIGNUP=true

# --- Engines (API keys) ---------------------------------------------------------------------
# Engines without a key are skipped. Costs per request with the default settings: see README.md ("Costs").
# ChatGPT (gpt-5.5, flex tier)
OPENAI_API_KEY=
# Gemini (gemini-3.5-flash with Google Search grounding)
GEMINI_API_KEY=
# Claude (Sonnet 5.5) AND the analysis of every answer (Haiku 5.5) – required for real measurements
ANTHROPIC_API_KEY=
# Perplexity (sonar) – optional
PERPLEXITY_API_KEY=
# Google AI Overviews + Google AI Mode via DataForSEO (https://dataforseo.com)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Cost protection ------------------------------------------------------------------------
# 1 = replace all engines and the analysis with a free local mock (no API calls; for trying it out and tests)
OPENGEO_MOCK_ENGINES=0
# Upper limit (USD) for the monthly budget any workspace may set (default 200). The worker enforces it too.
OPENGEO_MAX_BUDGET_USD=200
# 0 = never fetch the brand's own website (robots.txt, homepage) for technical recommendations (default: on)
# OPENGEO_SITE_CHECK=1

# --- Docker self-hosting (docker-compose.yml) ------------------------------------------------
# Host port and interface of the web dashboard. Keep 127.0.0.1 behind a reverse proxy;
# 0.0.0.0 exposes the port on all interfaces.
# OPENGEO_PORT=3010
# OPENGEO_BIND=127.0.0.1
# Image names; set them to use prebuilt images instead of building locally.
# OPENGEO_WEB_IMAGE=opengeo-web:local
# OPENGEO_WORKER_IMAGE=opengeo-worker:local

# --- Development / tests only ---------------------------------------------------------------
# Integration tests – set in your shell, not read from .env (database name must end in _test; created automatically)
# TEST_DATABASE_URL=postgres://opengeo:opengeo@localhost:5433/opengeo_test
# Cost in USD the mock engine reports per request (default 0)
# OPENGEO_MOCK_COST_USD=0
# Browser test (e2e/full-flow.mjs) – set in your shell: base URL and screenshot folder
# E2E_BASE=http://localhost:3010
# E2E_SHOTS=./e2e/shots
