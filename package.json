{
  "name": "opengeo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @opengeo/db push",
    "dev": "pnpm --filter @opengeo/web dev",
    "worker": "pnpm --filter @opengeo/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@11.13.1",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
