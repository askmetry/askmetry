{
  "name": "askmetry",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d db",
    "db:generate": "pnpm --filter @askmetry/db generate",
    "db:migrate": "pnpm --filter @askmetry/db migrate",
    "db:push": "pnpm --filter @askmetry/db push",
    "dev": "pnpm --filter @askmetry/web dev",
    "worker": "pnpm --filter @askmetry/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @askmetry/core test:unit && pnpm --filter @askmetry/web test",
    "test:integration": "pnpm --filter @askmetry/core test:integration"
  },
  "packageManager": "pnpm@11.13.1",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
